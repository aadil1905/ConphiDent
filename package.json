    "test:platform": "node --test tests/platform-authorization.integration.mjs",
    "test:scheduling": "node --test tests/scheduling-core.integration.mjs",
    "test:chart-concurrency": "node --test tests/chart-and-concurrency.integration.mjs",
    "test:tenant-guard": "node --test tests/tenant-guard.integration.mjs",
    "test:source": "node --test tests/*.source.test.mjs",
