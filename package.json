    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "test:reliability": "node --test tests/reliability.integration.mjs",
    "test:clinical": "node --test tests/clinical-core.integration.mjs",
    "test:imaging": "node --test tests/imaging.integration.mjs",
    "test:laboratory": "node --test tests/laboratory.integration.mjs",
