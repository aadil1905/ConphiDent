generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Appointment {
  id              Int       @id @default(autoincrement())
  clinicId        Int
  phone           String
  createdAt       DateTime  @default(now())
  appointmentDate DateTime
  appointmentTime String
  notes           String?
  patientName     String
  source          String    @default("WhatsApp")
  status          String    @default("Pending")
  reminderSentAt  DateTime?
  treatment       String
  patientId       Int?
  providerId      Int?
  chairId         Int?
  archivedAt      DateTime?
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  provider        ClinicProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  chair           ClinicChair? @relation(fields: [chairId], references: [id], onDelete: SetNull)
  lead            Lead?
  selfServiceRequests AppointmentSelfServiceRequest[]

  @@index([clinicId, archivedAt, appointmentDate])
  @@index([clinicId, status, appointmentDate, appointmentTime])
  @@index([patientId])
  @@index([clinicId, providerId, appointmentDate])
  @@index([clinicId, chairId, appointmentDate])
}

model Patient {
  id                 Int                    @id @default(autoincrement())
  clinicId           Int
  fullName           String
  phone              String
  email              String?
  dateOfBirth        DateTime?
  gender             String?
  address            String?
  medicalNotes       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  appointments       Appointment[]
  clinicalRecords    ClinicalRecord[]
  treatmentPlans     TreatmentPlan[]
  invoices           Invoice[]
  prescriptions      Prescription[]
  dentalChartEntries DentalChartEntry[]
  labCases           LabCase[]
  intakeRequests     PatientIntakeRequest[]
  clinic             Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  @@unique([clinicId, phone])
  @@index([clinicId, fullName])
  @@index([clinicId, createdAt])
  @@index([fullName])
}

model Invoice {
  id              Int            @id @default(autoincrement())
  invoiceNumber   String         @unique
  patientId       Int
  treatmentPlanId Int?
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  totalAmount     Int
  status          String         @default("Unpaid")
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  payments        Payment[]

  @@index([patientId, status])
  @@index([dueDate])
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  amount    Int
  method    String
  paidAt    DateTime @default(now())
  notes     String?
  recordedBy String?
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, paidAt])
}

model ClinicalRecord {
  id                Int       @id @default(autoincrement())
  patientId         Int
  visitDate         DateTime  @default(now())
  chiefComplaint    String
  diagnosis         String?
  clinicalNotes     String?
  medicalHistory    String?
  drugAllergies     String?
  medications       String?
  otherHistory      String?
  bloodPressure     String?
  weightKg          String?
  dentalHistory     String?
  treatmentDone     String?
  estimateAmount    Int?
  consentGiven      Boolean   @default(false)
  consentNotes      String?
  patientSignature  String?
  guardianSignature String?
  consentSignedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, visitDate])
}

model DentalChartEntry {
  id          Int      @id @default(autoincrement())
  patientId   Int
  toothNumber String
  visitDate   DateTime @default(now())
  condition   String   @default("HEALTHY")
  notes       String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, toothNumber, visitDate])
  @@index([patientId, visitDate])
  @@index([patientId, condition])
}

model TreatmentPlan {
  id            Int                  @id @default(autoincrement())
  patientId     Int
  visitDate     DateTime?
  title         String
  status        String               @default("Proposed")
  estimatedCost Int?
  serviceId     Int?
  toothNumber   String?
  unitPrice     Int?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  labCases      LabCase[]
  service       ClinicService?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  selectedTeeth TreatmentPlanTooth[]
  items         TreatmentPlanItem[]

  @@index([patientId, status])
  @@index([patientId, visitDate])
  @@index([serviceId])
}

model TreatmentPlanItem {
  id              Int           @id @default(autoincrement())
  treatmentPlanId Int
  serviceId       Int?
  name            String
  price           Int
  createdAt       DateTime      @default(now())
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  service         ClinicService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([treatmentPlanId])
  @@index([serviceId])
}

model TreatmentPlanTooth {
  id              Int           @id @default(autoincrement())
  treatmentPlanId Int
  toothNumber     String
  createdAt       DateTime      @default(now())
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@unique([treatmentPlanId, toothNumber])
  @@index([toothNumber])
}

model Prescription {
  id               Int      @id @default(autoincrement())
  patientId        Int
  clinicalRecordId Int?
  prescribedOn     DateTime @default(now())
  diagnosis        String?
  instructions     String?
  medicines        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, prescribedOn])
}

model Clinic {
  id              Int                     @id @default(autoincrement())
  name            String
  slug            String?                 @unique
  status          String                  @default("ACTIVE")
  brandName       String?
  logoUrl         String?
  accentColor     String                  @default("#0369a1")
  phone           String?
  email           String?
  address         String?
  timezone        String                  @default("Asia/Kolkata")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  users           User[]
  services        ClinicService[]
  hours           ClinicHours[]
  whatsapp        ClinicWhatsAppSettings?
  whatsappConnection ClinicWhatsAppConnection?
  whatsappTemplates  WhatsAppTemplate[]
  whatsappAutomations WhatsAppAutomation[]
  scheduledWhatsAppMessages ScheduledWhatsAppMessage[]
  whatsappConnectionLogs WhatsAppConnectionLog[]
  leads           Lead[]
  faqs            ClinicFAQ[]
  conversations   WhatsAppConversation[]
  followUpTasks   FollowUpTask[]
  inventoryItems  InventoryItem[]
  labCases        LabCase[]
  labEvents       LabCaseEvent[]
  labPayments     LabPayment[]
  vendors         Vendor[]
  launchChecklist ClinicLaunchChecklist?
  intakeRequests  PatientIntakeRequest[]
  appointments    Appointment[]
  providers       ClinicProvider[]
  chairs          ClinicChair[]
  patients        Patient[]
  appointmentSelfServiceRequests AppointmentSelfServiceRequest[]
  auditLogs       AuditLog[]

  @@index([status, createdAt])
}

model DemoRequest {
  id            String   @id @default(cuid())
  name          String
  clinicName    String
  phone         String
  email         String
  city          String
  doctorCount   String
  preferredTime String
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model ClinicProvider {
  id          Int           @id @default(autoincrement())
  clinicId    Int
  name        String
  active      Boolean       @default(true)
  appointments Appointment[]
  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, name])
}

model ClinicChair {
  id          Int           @id @default(autoincrement())
  clinicId    Int
  name        String
  active      Boolean       @default(true)
  appointments Appointment[]
  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, name])
}

model User {
  id           Int        @id @default(autoincrement())
  clinicId     Int
  fullName     String
  email        String     @unique
  passwordHash String
  role         String     @default("RECEPTIONIST")
  active       Boolean    @default(true)
  platformAdmin Boolean   @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  clinic       Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sessions     Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs    AuditLog[]
  ownedLeads   Lead[]     @relation("LeadOwner")
  assignedConversations WhatsAppConversation[] @relation("ConversationAssignee")

  @@index([clinicId, role])
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ClinicService {
  id              Int             @id @default(autoincrement())
  clinicId        Int
  name            String
  description     String?
  durationMinutes Int             @default(30)
  price           Int?
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatmentPlans  TreatmentPlan[]
  treatmentPlanItems TreatmentPlanItem[]

  @@index([clinicId, active, sortOrder])
}

model ClinicHours {
  id          Int     @id @default(autoincrement())
  clinicId    Int
  dayOfWeek   Int
  openTime    String  @default("09:00")
  closeTime   String  @default("18:00")
  slotMinutes Int     @default(30)
  isClosed    Boolean @default(false)
  clinic      Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
}

model ClinicWhatsAppSettings {
  id              Int      @id @default(autoincrement())
  clinicId        Int      @unique
  welcomeEnglish  String?
  welcomeHindi    String?
  welcomeHinglish String?
  welcomeMarathi  String?
  contactMessage  String?
  bookingIntro    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

/// Meta Cloud API assets are always stored per clinic. The bearer token is encrypted
/// at rest and is deliberately never selected by dashboard pages or returned to a client.
model ClinicWhatsAppConnection {
  id                  Int      @id @default(autoincrement())
  clinicId            Int      @unique
  wabaId              String   @unique
  phoneNumberId       String   @unique
  businessId          String?
  displayPhoneNumber  String?
  verifiedName        String?
  businessName        String?
  qualityRating       String?
  messagingLimit      String?
  webhookVerifiedAt   DateTime?
  lastSyncedAt        DateTime?
  tokenCiphertext     String
  tokenIv             String
  tokenTag            String
  connectedAt         DateTime @default(now())
  lastVerifiedAt      DateTime?
  disconnectedAt      DateTime?
  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  logs                WhatsAppConnectionLog[]

  @@index([phoneNumberId])
  @@index([wabaId])
}

model WhatsAppConnectionLog {
  id          Int      @id @default(autoincrement())
  clinicId    Int
  connectionId Int?
  event       String
  detail      String?
  createdAt   DateTime @default(now())
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  connection  ClinicWhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([connectionId, createdAt])
}

model WhatsAppTemplate {
  id          Int      @id @default(autoincrement())
  clinicId    Int
  name        String
  language    String   @default("en")
  category    String?
  status      String   @default("DRAFT")
  providerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, name, language])
  @@index([clinicId, status])
}

model WhatsAppAutomation {
  id          Int      @id @default(autoincrement())
  clinicId    Int
  name        String
  trigger     String
  enabled     Boolean  @default(true)
  templateId  Int?
  configuration String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, enabled])
}

model Lead {
  id                  Int            @id @default(autoincrement())
  clinicId            Int
  fullName            String
  phone               String
  email               String?
  serviceInterest     String?
  source              String         @default("WhatsApp")
  stage               String         @default("NEW")
  notes               String?
  lossReason          String?
  conversionValue     Int?
  recoveredAt         DateTime?
  lastContactedAt     DateTime?
  nextFollowUpAt      DateTime?
  ownerId             Int?
  bookedAppointmentId Int?           @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  clinic              Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  owner               User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  bookedAppointment   Appointment?   @relation(fields: [bookedAppointmentId], references: [id], onDelete: SetNull)
  activities          LeadActivity[]
  followUpTasks       FollowUpTask[]

  @@unique([clinicId, phone])
  @@index([clinicId, stage, createdAt])
  @@index([clinicId, nextFollowUpAt])
  @@index([clinicId, ownerId, nextFollowUpAt])
}

model LeadActivity {
  id        Int      @id @default(autoincrement())
  leadId    Int
  type      String
  content   String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  clinicId   Int
  userId     Int?
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([userId, createdAt])
}

model ClinicFAQ {
  id        Int      @id @default(autoincrement())
  clinicId  Int
  question  String
  answer    String
  category  String   @default("GENERAL")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, active, sortOrder])
}

model WhatsAppConversation {
  id            Int               @id @default(autoincrement())
  clinicId      Int
  phone         String
  language      String?
  status        String            @default("OPEN")
  label         String?
  assignedUserId Int?
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  clinic        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  assignedUser  User?             @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages      WhatsAppMessage[]
  booking       WhatsAppBooking?

  @@unique([clinicId, phone])
  @@index([clinicId, lastMessageAt])
  @@index([clinicId, status, assignedUserId])
}

model WhatsAppMessage {
  id             Int                  @id @default(autoincrement())
  conversationId Int
  providerMessageId String?           @unique
  direction      String
  content        String
  messageType    String               @default("TEXT")
  deliveryStatus String                @default("QUEUED")
  statusUpdatedAt DateTime?
  failureReason String?
  createdAt      DateTime             @default(now())
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([providerMessageId])
}

/// A durable per-clinic outbox. Rows are retained after cancellation or delivery for auditability.
model ScheduledWhatsAppMessage {
  id                Int      @id @default(autoincrement())
  clinicId          Int
  phone             String
  content           String
  messageType       String   @default("TEXT")
  scheduledAt       DateTime
  status            String   @default("SCHEDULED")
  attempts          Int      @default(0)
  maxAttempts       Int      @default(3)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  cancelledAt       DateTime?
  failureReason     String?
  providerMessageId String?
  createdByUserId   Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status, scheduledAt])
  @@index([clinicId, phone, createdAt])
}

model WhatsAppBooking {
  id              Int                  @id @default(autoincrement())
  conversationId  Int                  @unique
  step            String               @default("name")
  patientName     String               @default("")
  phone           String               @default("")
  appointmentDate String               @default("")
  appointmentTime String               @default("")
  reason          String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  conversation    WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model FollowUpTask {
  id           Int       @id @default(autoincrement())
  clinicId     Int
  leadId       Int?
  patientName  String
  phone        String
  taskType     String
  channel      String    @default("WHATSAPP")
  status       String    @default("PENDING")
  message      String
  scheduledFor DateTime  @default(now())
  sentAt       DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  snoozedUntil DateTime?
  metadata     String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([clinicId, status, scheduledFor])
  @@index([leadId])
}

model InventoryItem {
  id           Int      @id @default(autoincrement())
  clinicId     Int
  name         String
  category     String   @default("Clinical supplies")
  unit         String   @default("units")
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  costPerUnit  Int?
  supplier     String?
  batchNumber  String?
  expiryDate   DateTime?
  sku          String?
  barcode      String?
  brand        String?
  storageLocation String?
  maximumQuantity Int?
  sellingPrice Int?
  gstPercent   Int?
  vendorId     Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  vendor       Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([clinicId, name])
  @@index([clinicId, active, quantity])
  @@index([vendorId])
}

model Vendor {
  id           Int      @id @default(autoincrement())
  clinicId     Int
  name         String
  gstNumber    String?
  contactName  String?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  outstanding  Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([clinicId, name])
  @@index([clinicId, active])
}

model InventoryMovement {
  id              Int           @id @default(autoincrement())
  inventoryItemId Int
  clinicId        Int
  quantityChange  Int
  type            String
  notes           String?
  patientId       Int?
  treatmentPlanId Int?
  recordedBy      String?
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
  @@index([inventoryItemId, createdAt])
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  clinicId    Int
  supplier    String
  status      String              @default("DRAFT")
  notes       String?
  createdBy   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]

  @@index([clinicId, status, createdAt])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  inventoryItemId Int
  quantity        Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, inventoryItemId])
}

model LabCase {
  id              Int            @id @default(autoincrement())
  clinicId        Int
  patientId       Int
  treatmentPlanId Int?
  labName         String
  caseType        String
  status          String         @default("SENT_TO_LAB")
  dueDate         DateTime?
  notes           String?
  orderNumber     String?
  teeth           String?
  priority        String         @default("NORMAL")
  treatingDoctor  String?
  assistant       String?
  technicianName  String?
  labPhone        String?
  labWhatsapp     String?
  shade           String?
  material        String?
  marginType      String?
  occlusionNotes  String?
  biteNotes       String?
  attachments     String?
  version         Int            @default(1)
  parentCaseId    Int?
  reworkReason    String?
  reworkCount     Int            @default(0)
  deliveredAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  clinic          Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  parentCase      LabCase?       @relation("LabCaseVersions", fields: [parentCaseId], references: [id], onDelete: SetNull)
  reworks         LabCase[]      @relation("LabCaseVersions")
  events          LabCaseEvent[]
  payments        LabPayment[]

  @@index([clinicId, status, dueDate])
  @@index([patientId, createdAt])
  @@index([clinicId, parentCaseId])
}

model LabCaseEvent {
  id        Int      @id @default(autoincrement())
  clinicId  Int
  labCaseId Int
  type      String
  notes     String?
  actorName String?
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  labCase   LabCase  @relation(fields: [labCaseId], references: [id], onDelete: Cascade)

  @@index([labCaseId, createdAt])
  @@index([clinicId, createdAt])
}

model LabPayment {
  id            Int      @id @default(autoincrement())
  clinicId      Int
  labCaseId     Int
  amount        Int
  paidAt        DateTime @default(now())
  invoiceNumber String?
  gstPercent    Int?
  status        String   @default("PAID")
  notes         String?
  createdAt     DateTime @default(now())
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  labCase       LabCase  @relation(fields: [labCaseId], references: [id], onDelete: Cascade)

  @@index([clinicId, paidAt])
  @@index([labCaseId])
}

model ClinicLaunchChecklist {
  id                        Int      @id @default(autoincrement())
  clinicId                  Int      @unique
  whatsappWebhookVerified   Boolean  @default(false)
  whatsappTemplatesApproved Boolean  @default(false)
  backupOwnerAssigned       Boolean  @default(false)
  clinicTeamTrained         Boolean  @default(false)
  backupPlanReviewed        Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  clinic                    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model PatientIntakeRequest {
  id                Int       @id @default(autoincrement())
  clinicId          Int
  patientId         Int
  token             String    @unique
  status            String    @default("CREATED")
  expiresAt         DateTime
  sentAt            DateTime?
  openedAt          DateTime?
  completedAt       DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?
  medicalHistory    String?
  drugAllergies     String?
  medications       String?
  otherHistory      String?
  bloodPressure     String?
  weightKg          String?
  dentalHistory     String?
  consentGiven      Boolean   @default(false)
  consentNotes      String?
  patientSignature  String?
  guardianSignature String?
  treatmentDone     String?
  estimateAmount    Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, status, createdAt])
  @@index([patientId, createdAt])
  @@index([expiresAt])
}

model AppointmentSelfServiceRequest {
  id              Int         @id @default(autoincrement())
  clinicId        Int
  appointmentId   Int
  token           String      @unique
  status          String      @default("PENDING")
  expiresAt       DateTime
  sentAt          DateTime?
  openedAt        DateTime?
  respondedAt     DateTime?
  requestedTime   String?
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  clinic          Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId, status, expiresAt])
  @@index([appointmentId, createdAt])
  @@index([expiresAt])
}
