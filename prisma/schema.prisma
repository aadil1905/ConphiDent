}

model LabPayment {
  id            Int      @id @default(autoincrement())
  clinicId      Int
  labCaseId     Int
  amount        Int
  paidAt        DateTime @default(now())
  invoiceNumber String?
  gstPercent    Int?
  status        String   @default("PAID")
  notes         String?
  createdAt     DateTime @default(now())
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  labCase       LabCase  @relation(fields: [labCaseId], references: [id], onDelete: Cascade)

  @@index([clinicId, paidAt])
  @@index([labCaseId])
}

model ClinicLaunchChecklist {
  id                        Int      @id @default(autoincrement())
  clinicId                  Int      @unique
  whatsappWebhookVerified   Boolean  @default(false)
  whatsappTemplatesApproved Boolean  @default(false)
  backupOwnerAssigned       Boolean  @default(false)
  clinicTeamTrained         Boolean  @default(false)
  backupPlanReviewed        Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  clinic                    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

/// Inactive portal identity foundation. No patient authentication is enabled until OTP delivery is configured.
model PatientPortalAccess {
  id              String    @id @default(cuid())
  clinicId        Int
  patientId       Int       @unique
  status          String    @default("PREPARED")
  deliveryChannel String?
  preparedAt      DateTime  @default(now())
  activatedAt     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
}

model PatientIntakeRequest {
  id                Int       @id @default(autoincrement())
  clinicId          Int
  patientId         Int
  token             String    @unique
  status            String    @default("CREATED")
  expiresAt         DateTime
  sentAt            DateTime?
  openedAt          DateTime?
  completedAt       DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?
  medicalHistory    String?
  drugAllergies     String?
  medications       String?
  otherHistory      String?
  bloodPressure     String?
  weightKg          String?
  dentalHistory     String?
  consentGiven      Boolean   @default(false)
  consentNotes      String?
  patientSignature  String?
  guardianSignature String?
  treatmentDone     String?
  estimateAmount    Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, status, createdAt])
  @@index([patientId, createdAt])
  @@index([expiresAt])
}

model AppointmentSelfServiceRequest {
  id            Int         @id @default(autoincrement())
  clinicId      Int
  appointmentId Int
  token         String      @unique
  status        String      @default("PENDING")
  expiresAt     DateTime
  sentAt        DateTime?
  openedAt      DateTime?
  respondedAt   DateTime?
  requestedTime String?
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId, status, expiresAt])
  @@index([appointmentId, createdAt])
  @@index([expiresAt])
}

/// Control Centre workflow records are separate from clinical data and contain no patient content.
model PlatformOnboarding {
  id             Int       @id @default(autoincrement())
  clinicId       Int       @unique
  stage          String    @default("TENANT_CREATED")
  ownerId        Int?
  targetGoLiveAt DateTime?
  blockers       String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([stage, targetGoLiveAt])
  @@index([ownerId, stage])
}

/// A private, operator-owned staging record for the Control Centre wizard.
/// It deliberately contains no clinic configuration of record: the Clinic and
/// related tenant models become authoritative only once provisioning succeeds.
model PlatformProvisioningDraft {
  id          String    @id @default(cuid())
  ownerUserId Int
  data        Json
  status      String    @default("ACTIVE")
  currentStep Int       @default(0)
  archivedAt  DateTime?
  discardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerUserId, status, updatedAt])
  @@index([ownerUserId, updatedAt])
}

model PlatformSupportTicket {
  id          Int       @id @default(autoincrement())
  clinicId    Int?
  requester   String?
  category    String    @default("GENERAL")
  priority    String    @default("NORMAL")
  status      String    @default("OPEN")
  subject     String
  description String
  assignedTo  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  @@index([status, priority, updatedAt])
  @@index([clinicId, status])
  @@index([assignedTo, status])
}

model PlatformNotification {
  id        Int       @id @default(autoincrement())
  clinicId  Int?
  severity  String    @default("INFO")
  title     String
  detail    String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, severity, createdAt])
  @@index([clinicId, createdAt])
}

/// Internal-only operational notes. These are never selected by clinic SaaS routes.
model PlatformInternalNote {
  id        Int      @id @default(autoincrement())
  clinicId  Int
  authorId  Int
  category  String   @default("GENERAL")
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
  @@index([authorId, createdAt])
}

/// Small, platform-owned operational queue; it does not create clinic-visible tasks.
model PlatformTask {
  id          Int       @id @default(autoincrement())
  clinicId    Int?
  assigneeId  Int?
  title       String
  description String?
  priority    String    @default("NORMAL")
  status      String    @default("OPEN")
  dueAt       DateTime?
  createdById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clinic      Clinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([status, priority, dueAt])
  @@index([clinicId, status])
  @@index([assigneeId, status])
}

/// Announcement authoring is platform-only. Delivery to clinic SaaS is intentionally separate.
model PlatformAnnouncement {
  id             Int       @id @default(autoincrement())
  title          String
  message        String
  severity       String    @default("INFO")
  targetType     String    @default("ALL_CLINICS")
  targetClinicId Int?
  startsAt       DateTime  @default(now())
  endsAt         DateTime?
  dismissible    Boolean   @default(true)
  createdById    Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([targetType, startsAt, endsAt])
  @@index([targetClinicId, startsAt])
}
