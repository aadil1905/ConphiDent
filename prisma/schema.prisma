generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Appointment {
  id                  Int                             @id @default(autoincrement())
  clinicId            Int
  phone               String
  createdAt           DateTime                        @default(now())
  appointmentDate     DateTime
  appointmentTime     String
  notes               String?
  patientName         String
  source              String                          @default("WhatsApp")
  status              String                          @default("Pending")
  reminderSentAt      DateTime?
  treatment           String
  patientId           Int?
  locationId          Int?
  providerId          Int?
  chairId             Int?
  archivedAt          DateTime?
  clinic              Clinic                          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  location            ClinicLocation?                 @relation(fields: [locationId], references: [id], onDelete: SetNull)
  patient             Patient?                        @relation(fields: [patientId], references: [id], onDelete: SetNull)
  provider            ClinicProvider?                 @relation(fields: [providerId], references: [id], onDelete: SetNull)
  chair               ClinicChair?                    @relation(fields: [chairId], references: [id], onDelete: SetNull)
  lead                Lead?
  selfServiceRequests AppointmentSelfServiceRequest[]
  encounter           Encounter?
  labCases            LabCase[]

  @@index([clinicId, archivedAt, appointmentDate])
  @@index([clinicId, status, appointmentDate, appointmentTime])
  @@index([patientId])
  @@index([clinicId, providerId, appointmentDate])
  @@index([clinicId, chairId, appointmentDate])
  @@index([clinicId, locationId, appointmentDate, appointmentTime])
}

model Patient {
  id                      Int                      @id @default(autoincrement())
  clinicId                Int
  fullName                String
  phone                   String
  email                   String?
  dateOfBirth             DateTime?
  gender                  String?
  address                 String?
  medicalNotes            String?
  archivedAt              DateTime?
  archiveReason           String?
  archivedByUserId        Int?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  appointments            Appointment[]
  clinicalRecords         ClinicalRecord[]
  treatmentPlans          TreatmentPlan[]
  invoices                Invoice[]
  prescriptions           Prescription[]
  dentalChartEntries      DentalChartEntry[]
  labCases                LabCase[]
  leads                   Lead[]                   @relation("PatientLeads")
  conversations           WhatsAppConversation[]   @relation("PatientConversations")
  followUpTasks           FollowUpTask[]           @relation("PatientFollowUps")
  intakeRequests          PatientIntakeRequest[]
  portalAccess            PatientPortalAccess?
  encounters              Encounter[]
  dentitionAssessments    DentitionAssessment[]
  patientTeeth            PatientTooth[]
  dentalFindings          DentalFinding[]
  timelineEvents          PatientTimelineEvent[]
  imagingStudies          ImagingStudy[]
  imagingComparisons      ImagingComparison[]
  auditLogs               AuditLog[]               @relation("PatientAuditLogs")
  clinic                  Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  imagingMatchResolutions ImagingMatchResolution[]

  @@unique([clinicId, phone])
  @@index([clinicId, fullName])
  @@index([clinicId, archivedAt, createdAt])
  @@index([fullName])
}

model Invoice {
  id                Int               @id @default(autoincrement())
  publicId          String            @unique @default(cuid())
  invoiceNumber     String
  documentType      String            @default("TAX_INVOICE")
  currency          String            @default("INR")
  patientId         Int
  treatmentPlanId   Int?
  clinicId          Int
  encounterId       Int?
  issueDate         DateTime          @default(now())
  dueDate           DateTime?
  totalAmount       Int
  subtotalAmount    Int?
  discountAmount    Int               @default(0)
  taxAmount         Int               @default(0)
  status            String            @default("Unpaid")
  notes             String?
  terms             String?
  immutableSnapshot Json?
  finalizedAt       DateTime?
  parentInvoiceId   Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  voidedAt          DateTime?
  voidReason        String?
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  treatmentPlan     TreatmentPlan?    @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  clinic            Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  encounter         Encounter?        @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  payments          Payment[]
  lineItems         InvoiceLineItem[]
  parentInvoice     Invoice?          @relation("InvoiceAdjustments", fields: [parentInvoiceId], references: [id], onDelete: SetNull)
  adjustments       Invoice[]         @relation("InvoiceAdjustments")

  @@unique([clinicId, invoiceNumber])
  @@index([patientId, status])
  @@index([dueDate])
  @@index([clinicId, status, issueDate])
  @@index([encounterId])
  @@index([clinicId, documentType, issueDate])
  @@index([parentInvoiceId])
}

model InvoiceLineItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Int     @default(1)
  unitPrice   Int
  discount    Int     @default(0)
  taxPercent  Int     @default(0)
  lineTotal   Int
  sortOrder   Int     @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, sortOrder])
}

model Payment {
  id               Int        @id @default(autoincrement())
  invoiceId        Int
  clinicId         Int
  encounterId      Int?
  amount           Int
  method           String
  paidAt           DateTime   @default(now())
  notes            String?
  receiptNumber    String?
  referenceNumber  String?
  recordedBy       String?
  createdAt        DateTime   @default(now())
  status           String     @default("POSTED")
  reversedAt       DateTime?
  reversalReason   String?
  recordedByUserId Int?
  invoice          Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  clinic           Clinic     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  encounter        Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  recordedByUser   User?      @relation("PaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@unique([clinicId, receiptNumber])
  @@index([invoiceId, paidAt])
  @@index([clinicId, status, paidAt])
  @@index([encounterId])
}

model ClinicalRecord {
  id                   Int              @id @default(autoincrement())
  patientId            Int
  clinicId             Int
  encounterId          Int?
  providerId           Int?
  authorId             Int?
  visitDate            DateTime         @default(now())
  chiefComplaint       String
  diagnosis            String?
  clinicalNotes        String?
  medicalHistory       String?
  drugAllergies        String?
  medications          String?
  otherHistory         String?
  bloodPressure        String?
  weightKg             String?
  dentalHistory        String?
  treatmentDone        String?
  estimateAmount       Int?
  consentGiven         Boolean          @default(false)
  consentNotes         String?
  patientSignature     String?
  guardianSignature    String?
  consentSignedAt      DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  status               String           @default("DRAFT")
  source               String           @default("MANUAL")
  version              Int              @default(1)
  signedAt             DateTime?
  enteredInErrorAt     DateTime?
  enteredInErrorReason String?
  supersedesId         Int?             @unique
  patient              Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic               Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  encounter            Encounter?       @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  provider             ClinicProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  author               User?            @relation("ClinicalRecordAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  supersedes           ClinicalRecord?  @relation("ClinicalRecordVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  corrections          ClinicalRecord[] @relation("ClinicalRecordVersions")

  @@index([patientId, visitDate])
  @@index([clinicId, status, visitDate])
  @@index([encounterId, status])
}

model DentalChartEntry {
  id          Int        @id @default(autoincrement())
  patientId   Int
  clinicId    Int
  encounterId Int?
  authorId    Int?
  toothNumber String
  visitDate   DateTime   @default(now())
  condition   String     @default("HEALTHY")
  notes       String?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
  status      String     @default("CURRENT")
  source      String     @default("CLINICAL_WORKSPACE")
  version     Int        @default(1)
  patient     Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic      Clinic     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  author      User?      @relation("LegacyChartAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([patientId, toothNumber, visitDate])
  @@index([patientId, visitDate])
  @@index([patientId, condition])
  @@index([clinicId, encounterId])
}

model TreatmentPlan {
  id                 Int                  @id @default(autoincrement())
  patientId          Int
  clinicId           Int
  encounterId        Int?
  providerId         Int?
  authorId           Int?
  visitDate          DateTime?
  title              String
  status             String               @default("Proposed")
  estimatedCost      Int?
  serviceId          Int?
  toothNumber        String?
  unitPrice          Int?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  source             String               @default("MANUAL")
  version            Int                  @default(1)
  cancelledAt        DateTime?
  cancellationReason String?
  patient            Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic             Clinic               @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  encounter          Encounter?           @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  provider           ClinicProvider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  author             User?                @relation("TreatmentPlanAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  invoices           Invoice[]
  labCases           LabCase[]
  service            ClinicService?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  selectedTeeth      TreatmentPlanTooth[]
  items              TreatmentPlanItem[]
  imagingStudies     ImagingStudy[]
  imagingComparisons ImagingComparison[]

  @@index([patientId, status])
  @@index([patientId, visitDate])
  @@index([serviceId])
  @@index([clinicId, status, updatedAt])
  @@index([encounterId])
}

model TreatmentPlanItem {
  id              Int            @id @default(autoincrement())
  treatmentPlanId Int
  serviceId       Int?
  name            String
  price           Int
  createdAt       DateTime       @default(now())
  treatmentPlan   TreatmentPlan  @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  service         ClinicService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  labCases        LabCase[]

  @@index([treatmentPlanId])
  @@index([serviceId])
}

model TreatmentPlanTooth {
  id              Int           @id @default(autoincrement())
  treatmentPlanId Int
  toothNumber     String
  createdAt       DateTime      @default(now())
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@unique([treatmentPlanId, toothNumber])
  @@index([toothNumber])
}

model Prescription {
  id                            Int                @id @default(autoincrement())
  patientId                     Int
  clinicId                      Int
  encounterId                   Int?
  providerId                    Int?
  authorId                      Int?
  clinicalRecordId              Int?
  prescribedOn                  DateTime           @default(now())
  diagnosis                     String?
  instructions                  String?
  medicines                     String
  allergySnapshot               String?
  patientAgeSnapshot            String?
  patientSexSnapshot            String?
  providerNameSnapshot          String?
  providerQualificationSnapshot String?
  providerRegistrationSnapshot  String?
  issuePlace                    String?
  safetyWarnings                Json?
  signatureStatement            String?
  signedAt                      DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  status                        String             @default("DRAFT")
  source                        String             @default("MANUAL")
  version                       Int                @default(1)
  issuedAt                      DateTime?
  cancelledAt                   DateTime?
  cancellationReason            String?
  supersedesId                  Int?               @unique
  patient                       Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinic                        Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  encounter                     Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  provider                      ClinicProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  author                        User?              @relation("PrescriptionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  supersedes                    Prescription?      @relation("PrescriptionVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  corrections                   Prescription[]     @relation("PrescriptionVersions")
  medicationItems               PrescriptionItem[]

  @@index([patientId, prescribedOn])
  @@index([clinicId, status, prescribedOn])
  @@index([encounterId])
}

model PrescriptionItem {
  id                  Int          @id @default(autoincrement())
  prescriptionId      Int
  genericName         String
  brandName           String?
  formulation         String?
  strength            String
  dosageForm          String
  dose                String
  doseUnit            String
  route               String
  frequency           String
  timing              String?
  mealRelation        String?
  startDate           DateTime?
  duration            String
  endDate             DateTime?
  quantity            String?
  asNeeded            Boolean      @default(false)
  maxDose             String?
  indication          String?
  instructions        String?
  substitutionAllowed Boolean      @default(true)
  sortOrder           Int          @default(0)
  prescription        Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)

  @@index([prescriptionId, sortOrder])
}

model PrescriptionTemplate {
  id           Int       @id @default(autoincrement())
  clinicId     Int
  name         String
  diagnosis    String?
  items        Json
  active       Boolean   @default(true)
  reviewedAt   DateTime?
  reviewedById Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([clinicId, name])
  @@index([clinicId, active, name])
}

/// One clinically meaningful episode of care. It replaces calendar-date joins
/// while keeping all legacy visit-date fields readable during migration.
model Encounter {
  id                   Int                    @id @default(autoincrement())
  clinicId             Int
  patientId            Int
  appointmentId        Int?                   @unique
  providerId           Int?
  locationId           Int?
  chairId              Int?
  createdById          Int?
  occurredAt           DateTime
  status               String                 @default("IN_PROGRESS")
  source               String                 @default("CLINIC")
  completedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  clinic               Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient              Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment          Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  provider             ClinicProvider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  location             ClinicLocation?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  chair                ClinicChair?           @relation(fields: [chairId], references: [id], onDelete: SetNull)
  createdBy            User?                  @relation("EncounterCreator", fields: [createdById], references: [id], onDelete: SetNull)
  clinicalRecords      ClinicalRecord[]
  legacyChartEntries   DentalChartEntry[]
  treatmentPlans       TreatmentPlan[]
  prescriptions        Prescription[]
  invoices             Invoice[]
  payments             Payment[]
  labCases             LabCase[]
  dentitionAssessments DentitionAssessment[]
  dentalFindings       DentalFinding[]
  timelineEvents       PatientTimelineEvent[]
  imagingStudies       ImagingStudy[]
  imagingComparisons   ImagingComparison[]

  @@index([clinicId, patientId, occurredAt])
  @@index([clinicId, status, occurredAt])
}

model DentitionAssessment {
  id               Int       @id @default(autoincrement())
  clinicId         Int
  patientId        Int
  encounterId      Int
  stage            String
  suggestedStage   String?
  ageMonths        Int?
  version          Int       @default(1)
  status           String    @default("CONFIRMED")
  confirmedById    Int
  confirmedAt      DateTime  @default(now())
  correctionReason String?
  createdAt        DateTime  @default(now())
  clinic           Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter        Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  confirmedBy      User      @relation("DentitionConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@unique([encounterId, version])
  @@index([clinicId, patientId, confirmedAt])
}

model PatientTooth {
  id              Int             @id @default(autoincrement())
  clinicId        Int
  patientId       Int
  dentition       String
  fdiCode         String?
  kind            String          @default("STANDARD")
  customLabel     String?
  adjacentFdiCode String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  findings        DentalFinding[]

  @@unique([patientId, dentition, fdiCode])
  @@index([clinicId, patientId, fdiCode])
}

/// Append-only chart history. A correction supersedes a prior row; it never
/// overwrites the clinical statement or original author.
model DentalFinding {
  id                 Int                 @id @default(autoincrement())
  clinicId           Int
  patientId          Int
  encounterId        Int
  patientToothId     Int
  toothCodeSnapshot  String
  recordType         String
  condition          String
  surfaces           String[]            @default([])
  notes              String?
  status             String              @default("ACTIVE")
  version            Int                 @default(1)
  authorId           Int
  source             String              @default("CLINICAL_WORKSPACE")
  signedAt           DateTime?
  correctionReason   String?
  supersedesId       Int?                @unique
  createdAt          DateTime            @default(now())
  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter          Encounter           @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patientTooth       PatientTooth        @relation(fields: [patientToothId], references: [id], onDelete: Restrict)
  author             User                @relation("DentalFindingAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  supersedes         DentalFinding?      @relation("DentalFindingVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  corrections        DentalFinding[]     @relation("DentalFindingVersions")
  imagingComparisons ImagingComparison[]

  @@index([clinicId, patientId, encounterId, status])
  @@index([patientToothId, status, createdAt])
}

model PatientTimelineEvent {
  id             Int        @id @default(autoincrement())
  clinicId       Int
  patientId      Int
  encounterId    Int?
  actorId        Int?
  eventType      String
  objectType     String
  objectId       String
  title          String
  summary        String?
  source         String     @default("APPLICATION")
  idempotencyKey String?    @unique
  occurredAt     DateTime   @default(now())
  createdAt      DateTime   @default(now())
  clinic         Clinic     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient        Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter      Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  actor          User?      @relation("TimelineActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, occurredAt])
  @@index([encounterId, occurredAt])
}

/// A configured imaging origin. Credentials are never stored here;
/// credentialKey references an approved external secret manager entry.
model ImagingSource {
  id            String               @id @default(cuid())
  clinicId      Int
  name          String
  adapterType   String
  status        String               @default("ACTIVE")
  baseUrl       String?
  credentialKey String?
  capabilities  Json?
  lastHealthAt  DateTime?
  lastSyncAt    DateTime?
  lastError     String?
  revokedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  clinic        Clinic               @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  studies       ImagingStudy[]
  ingestEvents  ImagingIngestEvent[]

  @@unique([clinicId, name])
  @@index([clinicId, adapterType, status])
}

/// One governed imaging study. Original objects remain in private object
/// storage and are retrieved only through an authenticated tenant boundary.
model ImagingStudy {
  id                     String                   @id @default(cuid())
  clinicId               Int
  patientId              Int?
  encounterId            Int?
  treatmentPlanId        Int?
  orderingProviderId     Int?
  reviewingProviderId    Int?
  acquiringOperatorId    Int
  createdById            Int
  sourceId               String?
  sourceType             String
  status                 String                   @default("AVAILABLE")
  matchStatus            String                   @default("CONFIRMED")
  matchConfidence        Int?
  matchReason            String?
  modality               String
  treatmentStage         String?
  description            String?
  clinicalIndication     String?
  radiationMetadata      Json?
  anatomicalRegion       String?
  laterality             String?
  toothCodes             String[]                 @default([])
  acquisitionDate        DateTime
  accessionNumber        String?
  studyInstanceUid       String?
  dicomPatientId         String?
  externalPatientId      String?
  vendorRecordId         String?
  sourcePatientName      String?
  sourcePatientBirthDate DateTime?
  contentHash            String
  idempotencyKey         String
  numberOfSeries         Int                      @default(1)
  numberOfInstances      Int                      @default(1)
  version                Int                      @default(1)
  reviewedAt             DateTime?
  signedAt               DateTime?
  archivedAt             DateTime?
  archiveReason          String?
  enteredInErrorAt       DateTime?
  enteredInErrorReason   String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  clinic                 Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient                Patient?                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter              Encounter?               @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  treatmentPlan          TreatmentPlan?           @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  orderingProvider       ClinicProvider?          @relation("ImagingOrderingProvider", fields: [orderingProviderId], references: [id], onDelete: SetNull)
  reviewingProvider      ClinicProvider?          @relation("ImagingReviewingProvider", fields: [reviewingProviderId], references: [id], onDelete: SetNull)
  acquiringOperator      User                     @relation("ImagingAcquiringOperator", fields: [acquiringOperatorId], references: [id], onDelete: Restrict)
  createdBy              User                     @relation("ImagingStudyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  source                 ImagingSource?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  series                 ImagingSeries[]
  instances              ImagingInstance[]
  assets                 ImagingAsset[]
  reports                ImagingReport[]
  annotations            ImagingAnnotation[]
  baselineComparisons    ImagingComparison[]      @relation("ComparisonBaseline")
  followupComparisons    ImagingComparison[]      @relation("ComparisonFollowup")
  matchResolutions       ImagingMatchResolution[]
  ingestEvents           ImagingIngestEvent[]
  processingJobs         ImagingProcessingJob[]
  labCaseLinks           LabCaseImagingStudy[]

  @@unique([clinicId, idempotencyKey])
  @@unique([clinicId, contentHash])
  @@unique([clinicId, studyInstanceUid])
  @@index([clinicId, status, acquisitionDate])
  @@index([clinicId, matchStatus, createdAt])
  @@index([clinicId, patientId, acquisitionDate])
  @@index([clinicId, patientId, treatmentStage])
  @@index([encounterId, acquisitionDate])
  @@index([treatmentPlanId])
}

model ImagingSeries {
  id                String            @id @default(cuid())
  clinicId          Int
  studyId           String
  seriesInstanceUid String?
  seriesNumber      Int?
  modality          String
  description       String?
  bodySite          String?
  laterality        String?
  startedAt         DateTime?
  numberOfInstances Int               @default(1)
  createdAt         DateTime          @default(now())
  clinic            Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  study             ImagingStudy      @relation(fields: [studyId], references: [id], onDelete: Restrict)
  instances         ImagingInstance[]

  @@unique([studyId, seriesInstanceUid])
  @@index([clinicId, modality, startedAt])
  @@index([studyId, seriesNumber])
}

model ImagingInstance {
  id                String         @id @default(cuid())
  clinicId          Int
  studyId           String
  seriesId          String
  sopInstanceUid    String?
  sopClassUid       String?
  instanceNumber    Int?
  frameCount        Int            @default(1)
  transferSyntaxUid String?
  contentHash       String
  createdAt         DateTime       @default(now())
  clinic            Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  study             ImagingStudy   @relation(fields: [studyId], references: [id], onDelete: Restrict)
  series            ImagingSeries  @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  assets            ImagingAsset[]

  @@unique([clinicId, sopInstanceUid])
  @@unique([clinicId, contentHash])
  @@index([seriesId, instanceNumber])
  @@index([studyId])
}

model ImagingAsset {
  id                 String              @id @default(cuid())
  clinicId           Int
  studyId            String
  instanceId         String?
  role               String
  storageKey         String              @unique
  blobUrl            String
  contentType        String
  sizeBytes          Int
  originalName       String?
  sha256             String
  width              Int?
  height             Int?
  scanStatus         String              @default("BASIC_VALIDATED")
  derivedFromAssetId String?
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  study              ImagingStudy        @relation(fields: [studyId], references: [id], onDelete: Restrict)
  instance           ImagingInstance?    @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  derivedFrom        ImagingAsset?       @relation("ImagingAssetDerivatives", fields: [derivedFromAssetId], references: [id], onDelete: SetNull)
  derivatives        ImagingAsset[]      @relation("ImagingAssetDerivatives")
  annotations        ImagingAnnotation[]

  @@unique([studyId, role, version])
  @@index([clinicId, studyId, role])
  @@index([instanceId])
  @@index([derivedFromAssetId])
}

model ImagingReport {
  id               String          @id @default(cuid())
  clinicId         Int
  studyId          String
  authorId         Int
  status           String          @default("DRAFT")
  findings         String?
  impression       String?
  version          Int             @default(1)
  signedAt         DateTime?
  correctionReason String?
  supersedesId     String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  clinic           Clinic          @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  study            ImagingStudy    @relation(fields: [studyId], references: [id], onDelete: Restrict)
  author           User            @relation("ImagingReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  supersedes       ImagingReport?  @relation("ImagingReportVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  corrections      ImagingReport[] @relation("ImagingReportVersions")

  @@unique([studyId, version])
  @@index([clinicId, status, createdAt])
}

model ImagingAnnotation {
  id        String        @id @default(cuid())
  clinicId  Int
  studyId   String
  authorId  Int
  assetId   String?
  toothCode String?
  label     String
  geometry  Json
  status    String        @default("ACTIVE")
  version   Int           @default(1)
  createdAt DateTime      @default(now())
  clinic    Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  study     ImagingStudy  @relation(fields: [studyId], references: [id], onDelete: Restrict)
  author    User          @relation("ImagingAnnotationAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  asset     ImagingAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([clinicId, studyId, status])
  @@index([toothCode])
  @@index([assetId])
}

model ImagingComparison {
  id                 String         @id @default(cuid())
  clinicId           Int
  patientId          Int
  encounterId        Int?
  baselineStudyId    String
  followupStudyId    String
  treatmentPlanId    Int?
  completedFindingId Int?
  authorId           Int
  status             String         @default("FINAL")
  note               String
  compatibilityNote  String?
  signedAt           DateTime       @default(now())
  createdAt          DateTime       @default(now())
  clinic             Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter          Encounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  baselineStudy      ImagingStudy   @relation("ComparisonBaseline", fields: [baselineStudyId], references: [id], onDelete: Restrict)
  followupStudy      ImagingStudy   @relation("ComparisonFollowup", fields: [followupStudyId], references: [id], onDelete: Restrict)
  treatmentPlan      TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  completedFinding   DentalFinding? @relation(fields: [completedFindingId], references: [id], onDelete: SetNull)
  author             User           @relation("ImagingComparisonAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([clinicId, baselineStudyId, followupStudyId])
  @@index([clinicId, patientId, createdAt])
  @@index([encounterId])
  @@index([treatmentPlanId])
}

model ImagingMatchResolution {
  id                String       @id @default(cuid())
  clinicId          Int
  studyId           String
  patientId         Int
  resolvedById      Int
  decision          String
  signals           Json
  conflictingFields Json?
  reason            String
  createdAt         DateTime     @default(now())
  clinic            Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  study             ImagingStudy @relation(fields: [studyId], references: [id], onDelete: Restrict)
  patient           Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  resolvedBy        User         @relation("ImagingMatchResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([clinicId, studyId, createdAt])
  @@index([patientId, createdAt])
}

/// Durable inbox record for manual, DICOMweb, vendor, or local-bridge ingest.
model ImagingIngestEvent {
  id             String         @id @default(cuid())
  clinicId       Int
  sourceId       String?
  studyId        String?
  createdById    Int?
  idempotencyKey String
  payloadHash    String
  status         String         @default("RECEIVED")
  attempts       Int            @default(0)
  failureReason  String?
  receivedAt     DateTime       @default(now())
  processedAt    DateTime?
  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  source         ImagingSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  study          ImagingStudy?  @relation(fields: [studyId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("ImagingIngestActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, status, receivedAt])
}

/// Durable outbox for derivative generation and integration notifications.
model ImagingProcessingJob {
  id             String       @id @default(cuid())
  clinicId       Int
  studyId        String
  jobType        String
  idempotencyKey String
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  availableAt    DateTime     @default(now())
  lockedAt       DateTime?
  completedAt    DateTime?
  failureReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  study          ImagingStudy @relation(fields: [studyId], references: [id], onDelete: Restrict)

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, status, availableAt])
  @@index([studyId, status])
}

model Clinic {
  id                             Int                             @id @default(autoincrement())
  name                           String
  slug                           String?                         @unique
  status                         String                          @default("ACTIVE")
  brandName                      String?
  logoUrl                        String?
  accentColor                    String                          @default("#0369a1")
  phone                          String?
  email                          String?
  address                        String?
  gstin                          String?
  registrationNumber             String?
  invoicePrefix                  String                          @default("INV")
  receiptPrefix                  String                          @default("RCT")
  invoiceFooter                  String?
  paymentDetails                 String?
  timezone                       String                          @default("Asia/Kolkata")
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  users                          User[]
  services                       ClinicService[]
  hours                          ClinicHours[]
  whatsapp                       ClinicWhatsAppSettings?
  whatsappConnection             ClinicWhatsAppConnection?
  whatsappTemplates              WhatsAppTemplate[]
  whatsappAutomations            WhatsAppAutomation[]
  scheduledWhatsAppMessages      ScheduledWhatsAppMessage[]
  whatsappConnectionLogs         WhatsAppConnectionLog[]
  leads                          Lead[]
  faqs                           ClinicFAQ[]
  conversations                  WhatsAppConversation[]
  followUpTasks                  FollowUpTask[]
  inventoryItems                 InventoryItem[]
  labCases                       LabCase[]
  laboratories                   Laboratory[]
  labEvents                      LabCaseEvent[]
  labPayments                    LabPayment[]
  labMessages                    LabCaseMessage[]
  labAttachments                 LabCaseAttachment[]
  labPortalAccesses              LabPortalAccess[]
  labDeliveryAttempts            LabDeliveryAttempt[]
  labCaseImagingLinks            LabCaseImagingStudy[]
  vendors                        Vendor[]
  launchChecklist                ClinicLaunchChecklist?
  intakeRequests                 PatientIntakeRequest[]
  appointments                   Appointment[]
  providers                      ClinicProvider[]
  chairs                         ClinicChair[]
  patients                       Patient[]
  locations                      ClinicLocation[]
  mediaAssets                    ClinicMediaAsset[]
  subscription                   TenantSubscription?
  featureEntitlements            TenantFeatureEntitlement[]
  appointmentSelfServiceRequests AppointmentSelfServiceRequest[]
  auditLogs                      AuditLog[]
  patientPortalAccesses          PatientPortalAccess[]
  encounters                     Encounter[]
  dentitionAssessments           DentitionAssessment[]
  patientTeeth                   PatientTooth[]
  dentalFindings                 DentalFinding[]
  timelineEvents                 PatientTimelineEvent[]
  clinicalRecords                ClinicalRecord[]
  legacyChartEntries             DentalChartEntry[]
  treatmentPlans                 TreatmentPlan[]
  prescriptions                  Prescription[]
  invoices                       Invoice[]
  payments                       Payment[]
  internalNotes                  PlatformInternalNote[]
  platformTasks                  PlatformTask[]
  imagingSources                 ImagingSource[]
  imagingStudies                 ImagingStudy[]
  imagingSeries                  ImagingSeries[]
  imagingInstances               ImagingInstance[]
  imagingAssets                  ImagingAsset[]
  imagingReports                 ImagingReport[]
  imagingAnnotations             ImagingAnnotation[]
  imagingComparisons             ImagingComparison[]
  imagingMatchResolutions        ImagingMatchResolution[]
  imagingIngestEvents            ImagingIngestEvent[]
  imagingProcessingJobs          ImagingProcessingJob[]

  @@index([status, createdAt])
}

model DemoRequest {
  id            String   @id @default(cuid())
  name          String
  clinicName    String
  phone         String
  email         String
  city          String
  doctorCount   String
  preferredTime String
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model ClinicProvider {
  id                     Int                      @id @default(autoincrement())
  clinicId               Int
  name                   String
  active                 Boolean                  @default(true)
  appointments           Appointment[]
  clinic                 Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  locations              ClinicLocationProvider[]
  encounters             Encounter[]
  clinicalRecords        ClinicalRecord[]
  treatmentPlans         TreatmentPlan[]
  prescriptions          Prescription[]
  labCases               LabCase[]
  orderedImagingStudies  ImagingStudy[]           @relation("ImagingOrderingProvider")
  reviewedImagingStudies ImagingStudy[]           @relation("ImagingReviewingProvider")

  @@unique([clinicId, name])
}

model ClinicChair {
  id           Int           @id @default(autoincrement())
  clinicId     Int
  name         String
  active       Boolean       @default(true)
  appointments Appointment[]
  encounters   Encounter[]
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, name])
}

model User {
  id                         Int                      @id @default(autoincrement())
  clinicId                   Int
  fullName                   String
  email                      String                   @unique
  passwordHash               String
  mustChangePassword         Boolean                  @default(false)
  role                       String                   @default("RECEPTIONIST")
  active                     Boolean                  @default(true)
  platformAdmin              Boolean                  @default(false)
  /// Null preserves legacy platform administrators as Super Admins until a role is explicitly assigned.
  platformRole               String?
  emailVerifiedAt            DateTime?
  phone                      String?
  qualification              String?
  registrationNumber         String?
  signatureLabel             String?
  phoneVerifiedAt            DateTime?
  lastLoginAt                DateTime?
  failedLoginCount           Int                      @default(0)
  lockedUntil                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  clinic                     Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sessions                   Session[]
  passwordResetTokens        PasswordResetToken[]
  auditLogs                  AuditLog[]
  ownedLeads                 Lead[]                   @relation("LeadOwner")
  assignedConversations      WhatsAppConversation[]   @relation("ConversationAssignee")
  assignedFollowUps          FollowUpTask[]           @relation("FollowUpAssignee")
  authChallenges             AuthChallenge[]
  createdEncounters          Encounter[]              @relation("EncounterCreator")
  confirmedDentitions        DentitionAssessment[]    @relation("DentitionConfirmer")
  authoredDentalFindings     DentalFinding[]          @relation("DentalFindingAuthor")
  authoredClinicalRecords    ClinicalRecord[]         @relation("ClinicalRecordAuthor")
  authoredLegacyChartEntries DentalChartEntry[]       @relation("LegacyChartAuthor")
  authoredTreatmentPlans     TreatmentPlan[]          @relation("TreatmentPlanAuthor")
  authoredPrescriptions      Prescription[]           @relation("PrescriptionAuthor")
  authoredLabCases           LabCase[]                @relation("LabCaseAuthor")
  approvedLabCases           LabCase[]                @relation("LabCaseApprover")
  labCaseEvents              LabCaseEvent[]           @relation("LabCaseEventActor")
  labCaseMessages            LabCaseMessage[]         @relation("LabCaseMessageAuthor")
  labCaseAttachments         LabCaseAttachment[]      @relation("LabCaseAttachmentUploader")
  recordedPayments           Payment[]                @relation("PaymentRecorder")
  timelineEvents             PatientTimelineEvent[]   @relation("TimelineActor")
  createdImagingStudies      ImagingStudy[]           @relation("ImagingStudyCreator")
  acquiredImagingStudies     ImagingStudy[]           @relation("ImagingAcquiringOperator")
  authoredImagingReports     ImagingReport[]          @relation("ImagingReportAuthor")
  authoredImagingAnnotations ImagingAnnotation[]      @relation("ImagingAnnotationAuthor")
  authoredImagingComparisons ImagingComparison[]      @relation("ImagingComparisonAuthor")
  imagingMatchResolutions    ImagingMatchResolution[] @relation("ImagingMatchResolver")
  imagingIngestEvents        ImagingIngestEvent[]     @relation("ImagingIngestActor")

  @@index([clinicId, role])
  @@index([phone])
}

/// Hashed, short-lived verification codes for email, phone, and future MFA flows.
/// Codes are never stored or logged in plaintext.
model AuthChallenge {
  id          String    @id @default(cuid())
  userId      Int?
  purpose     String
  channel     String
  recipient   String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recipient, purpose, createdAt])
  @@index([userId, purpose, expiresAt])
}

/// Durable, provider-independent throttles for authentication and OTP abuse.
model SecurityRateLimit {
  id          String   @id @default(cuid())
  scope       String
  subjectHash String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, subjectHash])
  @@index([windowStart])
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ClinicService {
  id                 Int                     @id @default(autoincrement())
  clinicId           Int
  name               String
  description        String?
  durationMinutes    Int                     @default(30)
  price              Int?
  active             Boolean                 @default(true)
  sortOrder          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  clinic             Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatmentPlans     TreatmentPlan[]
  treatmentPlanItems TreatmentPlanItem[]
  locations          ClinicLocationService[]

  @@index([clinicId, active, sortOrder])
}

model ClinicHours {
  id          Int     @id @default(autoincrement())
  clinicId    Int
  dayOfWeek   Int
  openTime    String  @default("09:00")
  closeTime   String  @default("18:00")
  slotMinutes Int     @default(30)
  isClosed    Boolean @default(false)
  clinic      Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
}

/// A clinic may retain its legacy organization-level address while operating one
/// or more bookable branches. Existing clinics are backfilled with one primary location.
model ClinicLocation {
  id           Int                      @id @default(autoincrement())
  clinicId     Int
  name         String
  address      String?
  city         String?
  state        String?
  postalCode   String?
  phone        String?
  email        String?
  timezone     String?
  mapUrl       String?
  isPrimary    Boolean                  @default(false)
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  clinic       Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  hours        ClinicLocationHours[]
  providers    ClinicLocationProvider[]
  services     ClinicLocationService[]
  appointments Appointment[]
  encounters   Encounter[]

  @@unique([clinicId, name])
  @@index([clinicId, active, isPrimary])
}

/// Multiple rows per day allow branches to represent breaks and split shifts.
model ClinicLocationHours {
  id          Int            @id @default(autoincrement())
  locationId  Int
  dayOfWeek   Int
  openTime    String         @default("09:00")
  closeTime   String         @default("18:00")
  slotMinutes Int            @default(30)
  isClosed    Boolean        @default(false)
  sortOrder   Int            @default(0)
  location    ClinicLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek, sortOrder])
  @@index([locationId, dayOfWeek])
}

model ClinicLocationProvider {
  locationId Int
  providerId Int
  location   ClinicLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  provider   ClinicProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([locationId, providerId])
  @@index([providerId])
}

model ClinicLocationService {
  locationId Int
  serviceId  Int
  location   ClinicLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service    ClinicService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([locationId, serviceId])
  @@index([serviceId])
}

/// Metadata only: actual media bytes live in approved object storage, never Prisma.
model ClinicMediaAsset {
  id           String   @id @default(cuid())
  clinicId     Int
  kind         String
  storageKey   String   @unique
  publicUrl    String
  contentType  String
  sizeBytes    Int
  originalName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, kind, createdAt])
}

model SubscriptionPlan {
  id            Int                  @id @default(autoincrement())
  name          String               @unique
  code          String               @unique
  description   String?
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subscriptions TenantSubscription[]
}

model TenantSubscription {
  id            Int               @id @default(autoincrement())
  clinicId      Int               @unique
  planId        Int?
  status        String            @default("TRIAL")
  billingCycle  String            @default("MONTHLY")
  price         Int?
  currency      String            @default("INR")
  startsAt      DateTime          @default(now())
  trialEndsAt   DateTime?
  renewsAt      DateTime?
  cancelledAt   DateTime?
  internalNotes String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  clinic        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status, renewsAt])
  @@index([planId, status])
}

/// Tenant-level overrides are authoritative. A missing row falls back to the registry default.
model TenantFeatureEntitlement {
  id         Int      @id @default(autoincrement())
  clinicId   Int
  featureKey String
  enabled    Boolean  @default(true)
  source     String   @default("PLATFORM_OVERRIDE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, featureKey])
  @@index([featureKey, enabled])
}

model ClinicWhatsAppSettings {
  id              Int      @id @default(autoincrement())
  clinicId        Int      @unique
  welcomeEnglish  String?
  welcomeHindi    String?
  welcomeHinglish String?
  welcomeMarathi  String?
  contactMessage  String?
  bookingIntro    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

/// Meta Cloud API assets are always stored per clinic. The bearer token is encrypted
/// at rest and is deliberately never selected by dashboard pages or returned to a client.
model ClinicWhatsAppConnection {
  id                 Int                     @id @default(autoincrement())
  clinicId           Int                     @unique
  wabaId             String                  @unique
  phoneNumberId      String                  @unique
  businessId         String?
  displayPhoneNumber String?
  verifiedName       String?
  businessName       String?
  qualityRating      String?
  messagingLimit     String?
  webhookVerifiedAt  DateTime?
  lastSyncedAt       DateTime?
  tokenCiphertext    String
  tokenIv            String
  tokenTag           String
  connectedAt        DateTime                @default(now())
  lastVerifiedAt     DateTime?
  disconnectedAt     DateTime?
  clinic             Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  logs               WhatsAppConnectionLog[]

  @@index([phoneNumberId])
  @@index([wabaId])
}

model WhatsAppConnectionLog {
  id           Int                       @id @default(autoincrement())
  clinicId     Int
  connectionId Int?
  event        String
  detail       String?
  createdAt    DateTime                  @default(now())
  clinic       Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  connection   ClinicWhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([connectionId, createdAt])
}

model WhatsAppTemplate {
  id         Int      @id @default(autoincrement())
  clinicId   Int
  name       String
  language   String   @default("en")
  category   String?
  status     String   @default("DRAFT")
  providerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, name, language])
  @@index([clinicId, status])
}

model WhatsAppAutomation {
  id            Int      @id @default(autoincrement())
  clinicId      Int
  name          String
  trigger       String
  enabled       Boolean  @default(true)
  templateId    Int?
  configuration String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, trigger])
  @@index([clinicId, enabled])
}

model Lead {
  id                  Int                    @id @default(autoincrement())
  clinicId            Int
  fullName            String
  phone               String
  email               String?
  serviceInterest     String?
  source              String                 @default("WhatsApp")
  stage               String                 @default("NEW")
  notes               String?
  lossReason          String?
  conversionValue     Int?
  recoveredAt         DateTime?
  lastContactedAt     DateTime?
  nextFollowUpAt      DateTime?
  ownerId             Int?
  patientId           Int?
  bookedAppointmentId Int?                   @unique
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  clinic              Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  owner               User?                  @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  patient             Patient?               @relation("PatientLeads", fields: [patientId], references: [id], onDelete: SetNull)
  bookedAppointment   Appointment?           @relation(fields: [bookedAppointmentId], references: [id], onDelete: SetNull)
  activities          LeadActivity[]
  followUpTasks       FollowUpTask[]
  conversations       WhatsAppConversation[] @relation("LeadConversations")

  @@unique([clinicId, phone])
  @@index([clinicId, stage, createdAt])
  @@index([clinicId, nextFollowUpAt])
  @@index([clinicId, ownerId, nextFollowUpAt])
  @@index([clinicId, patientId])
}

model LeadActivity {
  id        Int      @id @default(autoincrement())
  leadId    Int
  type      String
  content   String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

